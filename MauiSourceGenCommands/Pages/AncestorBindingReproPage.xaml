<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MauiSourceGenCommands.PageModels"
             x:Class="MauiSourceGenCommands.Pages.AncestorBindingReproPage"
             x:DataType="vm:AncestorBindingReproPageModel"
             BindingContext="{DynamicResource AncestorBindingReproModel}"
             Title="Issue #38667">
    <Grid Padding="16" RowDefinitions="Auto,Auto,*" RowSpacing="12">
        <Label Text="Scroll down and back up to reproduce issue #38667." />
        <Label Grid.Row="1" Text="{Binding LastInvoked}" />
        <CollectionView Grid.Row="2" ItemsSource="{Binding Items}" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:AncestorBindingReproItem">
                    <Grid>
                        <SwipeView>
                            <SwipeView.LeftItems>
                                <SwipeItems Mode="Execute">
                                    <SwipeItem Text="Use" BackgroundColor="PaleGreen"
                                               Command="{Binding UseCommand, Source={RelativeSource AncestorType={x:Type vm:AncestorBindingReproPageModel}}, x:DataType=vm:AncestorBindingReproPageModel}"
                                               CommandParameter="{Binding .}" />
                                </SwipeItems>
                            </SwipeView.LeftItems>
                            <Grid Padding="8" ColumnDefinitions="*,Auto" HeightRequest="64">
                                <Label Text="{Binding Title}" VerticalOptions="Center" />
                                <ImageButton Grid.Column="1" Source="{StaticResource IconClean}" WidthRequest="48" HeightRequest="48"
                                             SemanticProperties.Description="Use item"
                                             Command="{Binding UseCommand, Source={RelativeSource AncestorType={x:Type vm:AncestorBindingReproPageModel}}, x:DataType=vm:AncestorBindingReproPageModel}"
                                             CommandParameter="{Binding .}" />
                            </Grid>
                        </SwipeView>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
